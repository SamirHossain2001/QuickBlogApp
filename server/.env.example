# QuickBlog server environment variables
# Copy this file to .env and fill in real values:  cp .env.example .env

# MongoDB connection string: the CLUSTER URI ONLY (no database name).
# The app automatically appends "/quickblog". Get this from MongoDB Atlas.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Secret used to sign admin tokens. Use a long, random string.
JWT_SECRET=replace_with_a_long_random_secret

# The single admin account (checked on POST /api/admin/login).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Google Gemini API key, used for AI blog content generation.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# ImageKit credentials, used to upload and optimize blog images.
# Find these in your ImageKit dashboard under Developer options.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Allowed frontend origins for CORS, comma separated.
# Leave empty to allow all origins (development only).
CLIENT_URL=http://localhost:5173

# Port for local development (optional; defaults to 3000).
PORT=3000
